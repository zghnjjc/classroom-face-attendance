{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "课堂签到：选择入口",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app_entry.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--role",
                "launcher"
            ]
        },
        {
            "name": "课堂签到：学生端",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app_entry.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--role",
                "student"
            ]
        },
        {
            "name": "课堂签到：教师管理",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app_entry.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--role",
                "admin"
            ]
        }
    ]
}
